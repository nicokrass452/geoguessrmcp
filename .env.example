# Game Backend & Web Server
PORT=3001
VITE_API_URL=http://localhost:3001
GAME_BACKEND_URL=http://localhost:3001

# MCP Server Settings (stdio | http | sse)
MCP_TRANSPORT=stdio
MCP_PORT=3002
MCP_SSE_PORT=3002
AGENT_NAME=AI Explorer
AGENT_MODEL=unknown

# Panorama Providers
# Options: auto | open | wikimedia | mapillary | google
PANORAMA_PROVIDER=auto

# Optional: fetch & disk-cache real 360 equirectangular images from Wikimedia Commons
# Falls back automatically to built-in procedural 360 panoramas if unreachable
ENABLE_WIKIMEDIA_FETCH=false

# Optional: Mapillary Graph API v4 + MapillaryJS token
MAPILLARY_ACCESS_TOKEN=

# Optional: Google Maps Street View Static API key
GOOGLE_MAPS_API_KEY=
